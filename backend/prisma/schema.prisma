generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model appointments {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id              String    @db.Uuid
  provider_name           String
  specialty               String
  start_time              DateTime  @db.Timestamptz(6)
  type                    String
  location_name           String?
  address                 String?
  join_url                String?
  status                  String    @default("Scheduled")
  notes                   String?
  visit_summary_available Boolean?  @default(false)
  created_at              DateTime? @default(now()) @db.Timestamptz(6)
  staff_id                String?   @db.Uuid
  hospital_id             String    @db.Uuid

  @@index([hospital_id, start_time(sort: Desc)], map: "idx_appointments_hospital_time")
  @@index([patient_id, start_time(sort: Desc)], map: "idx_appointments_patient_time")
  @@index([staff_id, start_time(sort: Desc)], map: "idx_appointments_staff_time")
}

model email_verifications {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staff_id       String         @db.Uuid
  code           String
  expires_at     DateTime       @db.Timestamptz(6)
  used_at        DateTime?      @db.Timestamptz(6)
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  staff_accounts staff_accounts @relation(fields: [staff_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([code], map: "idx_email_verifications_code")
  @@index([staff_id], map: "idx_email_verifications_staff_id")
}

model emergency_links {
  id         String   @id
  patient_id String   @db.Uuid
  token      String   @unique
  revoked    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp(6)
  patients   patients @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([patient_id])
}

model emergency_profiles {
  id                             String   @id
  patient_id                     String   @unique @db.Uuid
  share_blood_type               Boolean  @default(false)
  share_allergies                Boolean  @default(false)
  share_chronic_conditions       Boolean  @default(false)
  share_current_medications      Boolean  @default(false)
  share_emergency_contacts       Boolean  @default(false)
  blood_type                     String?
  allergies                      String?
  chronic_conditions             String?
  current_medications            String?
  emergency_contacts             Json?
  created_at                     DateTime @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime @default(now()) @db.Timestamptz(6)
  share_personal_info            Boolean  @default(true)
  share_medical_conditions       Boolean  @default(true)
  share_advance_directives       Boolean  @default(false)
  medical_conditions             String?
  emergency_contact_full_name    String?
  emergency_contact_relationship String?
  emergency_contact_phone        String?
  dnr_status                     String?
  living_will                    String?
}

model hospitals {
  id                           String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                         String                         @unique
  city                         String
  created_at                   DateTime                       @default(now()) @db.Timestamptz(6)
  patient_hospital_connections patient_hospital_connections[]
  staff_accounts               staff_accounts[]
}

model message_conversations {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id           String          @db.Uuid
  provider_id          String          @db.Uuid
  staff_id             String          @db.Uuid
  last_message_preview String?
  last_message_at      DateTime?       @db.Timestamptz(6)
  patient_last_read_at DateTime?       @db.Timestamptz(6)
  staff_last_read_at   DateTime?       @db.Timestamptz(6)
  created_at           DateTime        @default(now()) @db.Timestamptz(6)
  updated_at           DateTime        @default(now()) @db.Timestamptz(6)
  message_items        message_items[]

  @@unique([patient_id, provider_id, staff_id], map: "uniq_message_conversation")
  @@index([last_message_at(sort: Desc)], map: "idx_msg_conv_last")
  @@index([patient_id], map: "idx_msg_conv_patient")
  @@index([provider_id], map: "idx_msg_conv_provider")
  @@index([staff_id], map: "idx_msg_conv_staff")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model message_items {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id       String                @db.Uuid
  sender_type           String
  sender_patient_id     String?               @db.Uuid
  sender_staff_id       String?               @db.Uuid
  body                  String
  created_at            DateTime              @default(now()) @db.Timestamptz(6)
  message_conversations message_conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id, created_at], map: "idx_msg_items_conv_time")
}

model patient_hospital_connections {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id      String    @db.Uuid
  hospital_id     String    @db.Uuid
  connected_at    DateTime  @default(now()) @db.Timestamptz(6)
  disconnected_at DateTime? @db.Timestamptz(6)
  source          String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  hospitals       hospitals @relation(fields: [hospital_id], references: [id], onUpdate: NoAction)
  patients        patients  @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model patient_profiles {
  id                    String    @id @default(dbgenerated("gen_random_uuid()"))
  patient_id            String    @unique @db.Uuid
  first_name            String?
  last_name             String?
  dob                   DateTime? @db.Date
  health_card           String?
  phone_number          String?
  created_at            DateTime  @default(now()) @db.Timestamptz(6)
  home_address_line1    String?
  home_address_line2    String?
  home_city             String?
  home_province         String?   @default("ON")
  home_postal_code      String?
  mailing_same_as_home  Boolean?  @default(true)
  mailing_address_line1 String?
  mailing_address_line2 String?
  mailing_city          String?
  mailing_province      String?   @default("ON")
  mailing_postal_code   String?
  blood_type            String?
  allergies             String?
  medical_conditions    String?
  current_medications   String?
  dnr_status            String?
  living_will           String?
  emergency_contacts    Json?
}

model patient_provider_connections {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id      String    @db.Uuid
  provider_id     String    @db.Uuid
  connected_at    DateTime  @default(now()) @db.Timestamptz(6)
  disconnected_at DateTime? @db.Timestamptz(6)
  source          String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
}

model patients {
  id                           String                         @id @db.Uuid
  email                        String                         @unique
  password_hash                String
  terms_accepted_at            DateTime?                      @db.Timestamptz(6)
  created_at                   DateTime                       @default(now()) @db.Timestamptz(6)
  emergency_links              emergency_links[]
  oauth_identities             oauth_identities[]
  patient_hospital_connections patient_hospital_connections[]
}

model oauth_identities {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider       String
  provider_sub   String
  email          String
  email_verified Boolean         @default(false)
  patient_id     String?         @db.Uuid
  staff_id       String?         @db.Uuid
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @default(now()) @db.Timestamptz(6)
  patients       patients?       @relation(fields: [patient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  staff_accounts staff_accounts? @relation(fields: [staff_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, provider_sub], map: "oauth_identities_provider_provider_sub_key")
  @@index([patient_id], map: "idx_oauth_identities_patient_id")
  @@index([staff_id], map: "idx_oauth_identities_staff_id")
}

model pending_patient_intake {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String    @unique
  full_name          String?
  dob                DateTime? @db.Date
  phone_number       String?
  home_address       String?
  insurance          String?
  health_card        String?
  blood_type         String?
  allergies          String?
  medical_conditions String?
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
}

model staff_accounts {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hospital_id         String                @db.Uuid
  full_name           String
  email               String                @unique
  role                String
  phone               String?
  password_hash       String
  email_verified      Boolean               @default(false)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  email_verifications email_verifications[]
  hospitals           hospitals             @relation(fields: [hospital_id], references: [id], onUpdate: NoAction)
  oauth_identities    oauth_identities[]

  @@index([hospital_id], map: "idx_staff_accounts_hospital_id")
}
