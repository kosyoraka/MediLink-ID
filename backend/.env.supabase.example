PORT=4000
NODE_ENV=development
JWT_SECRET=change_me

# Supabase transaction pooler URL for normal app traffic
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# Direct connection used by Prisma commands that require a shadow database
SHADOW_DATABASE_URL="postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres"
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Patient app URL used for generated emergency/share links
FRONTEND_BASE_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174"

# Optional feature keys
OPENAI_API_KEY=""
GOOGLE_CLIENT_ID=""
RESEND_API_KEY=""
EMAIL_FROM="MediLink ID <no-reply@medilinkid.com>"
