{
  "name": "medilink-backend",
  "version": "1.0.0",
  "description": "Backend API for MediLinkID patient prototype",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "legacy:report": "node scripts/migrate-legacy-dump.js report",
    "legacy:migrate": "node scripts/migrate-legacy-dump.js apply",
    "gcp:report": "node scripts/migrate-gcp-to-supabase.js report",
    "gcp:migrate": "node scripts/migrate-gcp-to-supabase.js apply"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^7.2.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "google-auth-library": "^9.15.1",
    "jsonwebtoken": "^9.0.3",
    "openai": "^6.15.0",
    "passkit-generator": "^3.5.7",
    "pg": "^8.17.1",
    "postgres": "^3.4.8",
    "prisma": "^7.2.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
